# DOMINIO: el dominio publico (Caddy saca el certificado HTTPS solo) o ":80" para probar en local.
# USUARIO y CLAVE_HASH: la contrasena de la biblioteca (ver LEEME.md para generar el hash).
{$DOMINIO} {
	encode zstd gzip

	basic_auth {
		{$USUARIO} {$CLAVE_HASH}
	}

	handle /api/* {
		reverse_proxy app:8000
	}

	handle_path /pdf/* {
		root * /srv/pdf
		header Cache-Control "private, max-age=86400"
		file_server
	}

	handle {
		root * /srv/biblioteca
		header Cache-Control "no-cache"
		file_server
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
		-Server
	}
}
