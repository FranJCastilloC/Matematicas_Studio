# Copia este archivo como .env y completa los valores. El .env no se comparte con nadie.

# Dominio publico de la biblioteca (un registro A del dominio debe apuntar a la IP del VPS).
# Para probar en tu Mac sin HTTPS usa  DOMINIO=:80  y  PUERTO_HTTP=8080
DOMINIO=biblioteca.tudominio.com

# Usuario y contrasena para entrar. El hash se genera con:
#   docker run --rm caddy:2.8.4-alpine caddy hash-password --plaintext 'tu-contrasena'
# Cada $ del hash se escribe doble ($$) en este archivo.
USUARIO=francisco
CLAVE_HASH=

# Puertos en la maquina (en el VPS se dejan 80 y 443)
PUERTO_HTTP=80
PUERTO_HTTPS=443

# Para desplegar.sh: el VPS por SSH y la carpeta donde vive la biblioteca alli
VPS=usuario@ip-del-vps
CARPETA_VPS=/opt/biblioteca
